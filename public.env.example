# Copy to public.env on the server; do not commit public.env.
# DNS A/AAAA must point to your server, and inbound TCP 80/443 must be open.
PUBLIC_DOMAIN=demo.example.org
PUBLIC_EMAIL=operator@example.org
ACCESS_USER=reviewer
# Use a bcrypt hash from `caddy hash-password`, NOT the plaintext password.
# In a Compose env file, single-quote bcrypt's $ signs to prevent interpolation.
ACCESS_PASSWORD_HASH='$2a$14$REPLACE_WITH_GENERATED_HASH'
