# 可选：兼容 Chat Completions 请求格式的模型服务完整接口地址
# DeepSeek 官方兼容地址示例：
# LLM_CHAT_ENDPOINT=https://api.deepseek.com/chat/completions
# LLM_MODEL=deepseek-chat
# 本地 Ollama 示例：
# LLM_CHAT_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# LLM_MODEL=your-local-model
# LLM_API_KEY=
# 可选：按你账户实际价格填写，单位 USD / 1,000,000 tokens。
# LLM_INPUT_USD_PER_MILLION=0
# LLM_OUTPUT_USD_PER_MILLION=0
